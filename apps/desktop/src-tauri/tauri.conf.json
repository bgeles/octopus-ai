{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octopus AI",
  "version": "0.1.0",
  "identifier": "ai.octopus.desktop",
  "build": {
    "beforeDevCommand": "npm run sidecar:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Octopus AI",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Orquestrador local de agentes Claude por projeto",
    "copyright": "© 2026 Octopus AI",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2OEQwNTAwMkUxM0ZENTMKUldSVC9STXVBQVdOUnJnNmgvTzNKVEh3UHBYNFFjckNxL29NSEtLQVdvbWZaNGV0OU5LY2dia2MK",
      "endpoints": []
    }
  }
}
