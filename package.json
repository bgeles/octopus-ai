{
  "name": "octopus-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Orquestrador de projetos com agentes de IA (macOS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri dev -w @octopus/desktop",
    "build": "npm run build --workspaces --if-present",
    "build:app": "npm run tauri build -w @octopus/desktop",
    "test": "npm run test --workspaces --if-present",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
